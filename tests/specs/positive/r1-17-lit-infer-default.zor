// 字面量推断默认：整型 i64/浮点 f64（R1 §5）
fn consume(v: i64) { }

fn main() {
    let x = 1;
    let y = 2;
    let s = x + y;
    let f = 1.5;
    let g = f + f;
    consume(x);
    println(s); println(g);
}
