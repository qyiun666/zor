// Copy 表行 3/4：全 Copy 成员的 struct/元组赋值即复制
struct Pair { l: i64, r: i64 }

fn main() {
    let p = Pair { l: 1, r: 2 };
    let q = p;
    let t = (1, true);
    let u = t;
    println(q.l);
}
