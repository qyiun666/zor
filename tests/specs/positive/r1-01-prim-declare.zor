// tests/specs/positive/r1-01-prim-declare.zor — AC-R1-2 正例（specs/r1-type-system.md §9）
// 预期：编译成功，debug/release 双模式 zorcc exit 0、零诊断。
// 判据来源：PRD AC-R1-2/AC-R1-3；strict 实弹门禁（D-028）。

fn main() {
    let a: i8 = 1; let b: i16 = 2; let c: i32 = 3; let d: i64 = 4;
    let e: u8 = 5; let f: u16 = 6; let g: u32 = 7; let h: u64 = 8;
    let i: f32 = 1.5; let j: f64 = 2.5;
    let k: bool = true; let l: byte = 9; let m: unit = ();
    println(a); println(b); println(c); println(d);
    println(e); println(f); println(g); println(h);
    println(i); println(j); println(k); println(l); println(m);
}
