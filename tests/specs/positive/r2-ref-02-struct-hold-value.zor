// 判据来源：R1 §3 / R2 §7 In2 禁引用入容器（改持值）；对照源 tests/specs/compare/t-b-holder-ref-field-*.rs；载荷限 Copy（i64）；0.1.26 项 7。
// 单测同源 pos_r2_ref_02_struct_hold_value（r2_diag.rs）。

struct Holder { v: i64 }

fn read(h: &Holder) -> i64 { h.v }

fn main() {
    let h = Holder { v: 42 };
    let x = read(&h);
    println(x);
}
