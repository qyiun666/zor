// tests/specs/positive/r2-09-full-lifecycle-construct-borrow-release.zor — AC-R2 语义正例（specs/r2-ownership.md §7 全链组合）
// 预期：编译成功，debug/release 双模式 zorcc exit 0、零诊断。
// 判据来源：R2 §7 可表达（构造→借用→释放）全链一例，含函数内借用传参（§7）与 unbox 释放（§5）；单测同源 pos_full_lifecycle_construct_borrow_release（r2_diag.rs）；0.1.3 P4（追溯矩阵行 10 补位）。

struct P { x: i64 }

fn read(x: &i64) -> i64 {
    *x
}

fn bump(x: &mut i64) {
    *x = 9
}

fn main() {
    let b = box P { x: 3 };
    let v = read(&b.x);
    println(v);
    bump(&mut b.x);
    println(b.x);
    unbox b;
}
