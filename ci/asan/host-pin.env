# ZOR L2a CI-01 ASAN host pin
# 唯一零报告宿主：Linux x86_64 + GitHub Actions ubuntu-24.04 + clang 18.1.3。
# 由 ci/run_ci.sh 的 asan_host_pin_check 读取；任何一项不符即 ENV FAIL（strict 下 FAIL，不 SKIP）。
# 接线：stage_asan 以 CC_REAL=<clang-18 路径> 调用 QA-01 的 ci/asan/run_asan.sh。
ZOR_ASAN_OS_ID=ubuntu
ZOR_ASAN_OS_VERSION=24.04
ZOR_ASAN_ARCH=x86_64
ZOR_ASAN_CLANG_BIN=clang-18
ZOR_ASAN_CLANG=18.1.3
