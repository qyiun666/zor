#!/usr/bin/env bash
# ci/asan/cc-nog — L2a QA 去 -g 阴性对照 CC wrapper
# 与 cc-asan 的唯一差异＝不追加 -g；仍启用 ASAN，保证对照只改 debug-info 面。
# 由 zorcc 以 CC=<本文件绝对路径> 调用；实际编译器取 CC_REAL（默认 cc）。
set -euo pipefail
REAL_CC="${CC_REAL:-cc}"
case "$REAL_CC" in
  */cc-asan|*/cc-nog) echo "[cc-nog] CC_REAL 不得指向 wrapper 自身：$REAL_CC" >&2; exit 2 ;;
esac
exec "$REAL_CC" -fsanitize=address -fno-omit-frame-pointer "$@"
